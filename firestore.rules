rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function requestDoc(a, b) {
      return /databases/$(database)/documents/chat_requests/$(a + '_' + b);
    }

    // True when the two users have an ACCEPTED chat request in either direction,
    // evaluated against the state after the current write (so a batched accept works).
    function connectedAfter(a, b) {
      return (existsAfter(requestDoc(a, b)) && getAfter(requestDoc(a, b)).data.status == 'ACCEPTED')
        || (existsAfter(requestDoc(b, a)) && getAfter(requestDoc(b, a)).data.status == 'ACCEPTED');
    }

    function connected(a, b) {
      return (exists(requestDoc(a, b)) && get(requestDoc(a, b)).data.status == 'ACCEPTED')
        || (exists(requestDoc(b, a)) && get(requestDoc(b, a)).data.status == 'ACCEPTED');
    }

    // Profiles hold the email address, so only the owner and accepted contacts may read them.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || connected(request.auth.uid, userId));
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;

      match /clients/{clientId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if signedIn() && (
          request.auth.uid == userId ||
          (request.auth.uid == clientId && connectedAfter(userId, clientId))
        );
      }
    }

    // Username index used for "add client". It deliberately holds no email address.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update: if signedIn() && request.auth.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /chat_requests/{requestId} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.senderUid == request.auth.uid || resource.data.targetUid == request.auth.uid
      );
      // Only the sender can open a request, and it always starts as PENDING.
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.targetUid
        && request.resource.data.status == 'PENDING';
      allow update: if signedIn() && (
        // The recipient answers the request.
        (resource.data.targetUid == request.auth.uid
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.targetUid == resource.data.targetUid
          && request.resource.data.status in ['ACCEPTED', 'DECLINED', 'PENDING'])
        ||
        // The sender may only re-open a request that was declined.
        (resource.data.senderUid == request.auth.uid
          && resource.data.status == 'DECLINED'
          && request.resource.data.senderUid == resource.data.senderUid
          && request.resource.data.targetUid == resource.data.targetUid
          && request.resource.data.status == 'PENDING')
      );
      allow delete: if false;
    }

    // Chat messages live in the Realtime Database (see database.rules.json).
    match /conversations/{document=**} {
      allow read, write: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (
        resource == null ||
        resource.data.ownerUid == request.auth.uid ||
        ('participantUids' in resource.data && request.auth.uid in resource.data.participantUids)
      );
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.participantUids.size() <= 50;
      allow update: if signedIn() && (
        // The owner can edit everything except ownership.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid)
        ||
        // Other participants can only tick tasks off and move the status/progress.
        (request.auth.uid in resource.data.participantUids
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['tasks', 'progress', 'status', 'updatedAt']))
      );
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isValidMeeting(data) {
      return data.keys().hasAll(['id', 'title', 'organizerUid', 'participantUids', 'durationMinutes', 'status'])
        && data.id is string && data.id.size() > 0
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.organizerUid is string && data.organizerUid.size() > 0
        && data.participantUids is list && data.participantUids.size() > 0 && data.participantUids.size() <= 50
        && (data.durationMinutes is int || data.durationMinutes is number) && data.durationMinutes >= 1 && data.durationMinutes <= 480
        && data.status is string && data.status in ['Confirmed', 'Pending', 'Declined', 'Awaiting response', 'Cancelled', 'confirmed', 'pending', 'declined']
        && (!('clientName' in data) || data.clientName == null || data.clientName is string)
        && (!('dateString' in data) || data.dateString == null || data.dateString is string)
        && (!('time' in data) || data.time == null || data.time is string)
        && (!('duration' in data) || data.duration == null || data.duration is string)
        && (!('description' in data) || data.description == null || data.description is string)
        && (!('notes' in data) || data.notes == null || data.notes is string)
        && (!('isOnline' in data) || data.isOnline == null || data.isOnline is bool)
        && (!('scheduledAt' in data) || data.scheduledAt == null || data.scheduledAt is timestamp)
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    match /meetings/{meetingId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.organizerUid == request.auth.uid ||
        ('participantUids' in resource.data && request.auth.uid in resource.data.participantUids)
      );
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && isValidMeeting(request.resource.data);
      allow update: if request.auth != null && (
        (
          resource.data.organizerUid == request.auth.uid &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          request.auth.uid in request.resource.data.participantUids &&
          isValidMeeting(request.resource.data)
        ) ||
        (
          resource.data.organizerUid != request.auth.uid &&
          request.auth.uid in resource.data.participantUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status in ['Confirmed', 'Pending', 'Declined', 'Awaiting response']
        )
      );
      allow delete: if request.auth != null && resource.data.organizerUid == request.auth.uid;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'title', 'organizerUid', 'participantUids', 'amount', 'currencyCode', 'status', 'isPaid'])
        && data.id is string && data.id.size() > 0
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.organizerUid is string && data.organizerUid.size() > 0
        && data.participantUids is list && data.participantUids.size() > 0 && data.participantUids.size() <= 50
        && (data.amount is number || data.amount is int) && data.amount > 0
        && data.currencyCode is string && data.currencyCode in ['INR', 'USD', 'GBP']
        && data.status is string && data.status in ['UNPAID', 'PAID', 'CANCELLED']
        && data.isPaid is bool
        && (!('invoiceNumber' in data) || data.invoiceNumber == null || data.invoiceNumber is string)
        && (!('clientName' in data) || data.clientName == null || data.clientName is string)
        && (!('clientUid' in data) || data.clientUid == null || data.clientUid is string)
        && (!('projectId' in data) || data.projectId == null || data.projectId is string)
        && (!('projectName' in data) || data.projectName == null || data.projectName is string)
        && (!('dueDate' in data) || data.dueDate == null || data.dueDate is string)
        && (!('notes' in data) || data.notes == null || data.notes is string)
        && (!('paidAt' in data) || data.paidAt == null || data.paidAt is string)
        && (!('createdAt' in data) || data.createdAt == null || data.createdAt is string)
        && (!('createdAtTs' in data) || data.createdAtTs == null || data.createdAtTs is timestamp)
        && (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    match /invoices/{invoiceId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.organizerUid == request.auth.uid ||
        ('participantUids' in resource.data && request.auth.uid in resource.data.participantUids)
      );
      allow create: if request.auth != null
        && request.resource.data.organizerUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && isValidInvoice(request.resource.data);
      allow update: if request.auth != null && (
        (
          resource.data.organizerUid == request.auth.uid &&
          request.resource.data.organizerUid == resource.data.organizerUid &&
          isValidInvoice(request.resource.data)
        ) ||
        (
          request.auth.uid in resource.data.participantUids &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isPaid', 'paidAt', 'updatedAt']) &&
          request.resource.data.status in ['UNPAID', 'PAID'] &&
          request.resource.data.isPaid is bool
        )
      );
      allow delete: if request.auth != null && resource.data.organizerUid == request.auth.uid;
    }
  }
}
